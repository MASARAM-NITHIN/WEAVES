# ==============================================================================
# SREE PADMAVATHI SILKS - FRONTEND ENVIRONMENT (EXAMPLE)
# Copy this file to .env and fill in your real values. NEVER commit .env.
# On Replit, use Secrets instead.
# ==============================================================================

# Browser -> API base. '/api' = same-origin via the Next.js proxy to Spring Boot
# (works on localhost, Replit, or any domain without rebuilding).
NEXT_PUBLIC_API_BASE_URL=/api

# Server-to-server backend address (read at runtime by `next start`;
# used by API routes and server-side fetching — never exposed to the browser).
BACKEND_INTERNAL_URL=http://localhost:8080

# Image URL prefix for legacy/relative image paths stored in the database
NEXT_PUBLIC_IMAGE_URL_PREFIX=/uploads/

NEXT_PUBLIC_STORE_NAME=Sree Padmavathi Silks
NEXT_PUBLIC_STORE_PHONE=+919291303040
NEXT_PUBLIC_STORE_UPI_ID=you@upi
NEXT_PUBLIC_STORE_LOCATION=Hindupur, Andhra Pradesh