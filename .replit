run = "bash scripts/replit-start.sh"

hidden = [".config", "node_modules", "target", ".next", ".git"]

[nix]
channel = "stable-24_05"

[gitHubImport]
requiredFiles = [".replit", "replit.nix"]

[deployment]
build = ["bash", "scripts/replit-build.sh"]
run = ["bash", "scripts/replit-start.sh"]
deploymentTarget = "cloudrun"

# Single public port: Next.js (proxies /api and /uploads to Spring Boot).
[[ports]]
localPort = 3000
externalPort = 80
