# ==============================================================================
# SREE PADMAVATHI SILKS - BACKEND ENVIRONMENT (EXAMPLE)
# Copy this file to .env in the backend/saree-backend directory.
# NEVER commit .env. On Replit, use Secrets instead.
# ==============================================================================

# PostgreSQL Database (Flyway creates the schema automatically on first boot).
# Option 1: explicit JDBC coordinates (local dev / external Postgres)
DB_URL=jdbc:postgresql://localhost:5432/saree_db
DB_USERNAME=postgres
DB_PASSWORD=change-me
# Option 2: Replit Postgres — leave the three above unset and provide only:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# (scripts/replit-start.sh converts it to DB_URL/DB_USERNAME/DB_PASSWORD)

# Server port (internal; the public port belongs to the Next.js frontend)
PORT=8080
BACKEND_SERVICE_URL=http://localhost:8080

# CORS: exact frontend origin(s), comma-separated
CORS_ORIGINS=http://localhost:3000

# JWT Security (REQUIRED in production)
JWT_SECRET=replace-with-a-very-long-random-secret-at-least-256-bits
JWT_EXPIRATION_MS=86400000

# Local image storage directory (served publicly at /uploads/**)
APP_STORAGE_DIR=./uploads

# Owner Super Admin seed credentials (first boot only, when no admin exists)
OWNER_DEFAULT_USERNAME=owner
OWNER_DEFAULT_PASSWORD=change-me