# ==============================================================================
# SREE PADMAVATHI SILKS - GLOBAL ENVIRONMENT (EXAMPLE)
# Copy this file to .env and fill in your real values. NEVER commit .env.
# On Replit: put these in Secrets (workspace) AND Deployment Secrets.
# ==============================================================================

# ----------------------------------------------------------------------------
# PostgreSQL Database — TWO supported ways (pick one):
#  1. Replit Postgres: just provision the database; DATABASE_URL is provided
#     automatically and scripts/replit-start.sh derives the rest.
#  2. Any other Postgres: set DB_URL / DB_USERNAME / DB_PASSWORD explicitly.
# ----------------------------------------------------------------------------
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DB_URL=jdbc:postgresql://localhost:5432/saree_db
DB_USERNAME=postgres
DB_PASSWORD=change-me

# JWT Secret Key (REQUIRED in production; 256-bit+ for HMAC SHA-256)
JWT_SECRET=replace-with-a-very-long-random-secret-at-least-256-bits
JWT_EXPIRATION_MS=86400000

# Server & CORS Configuration
SERVER_PORT=8080
CORS_ORIGINS=http://localhost:3000

# Owner Super Admin Default Credentials (used only by the database seeder
# on first boot when no admin exists)
OWNER_DEFAULT_USERNAME=owner
OWNER_DEFAULT_PASSWORD=change-me

# ----------------------------------------------------------------------------
# Backend <-> Frontend wiring (Replit / single-port hosting)
# ----------------------------------------------------------------------------
# Public port for Next.js (Replit maps external 80 -> this)
PORT=3000
# Internal Spring Boot port (not public)
BACKEND_PORT=8080
# How Next.js reaches Spring Boot server-to-server (runtime env, no rebuild)
BACKEND_INTERNAL_URL=http://localhost:8080
# Browser -> API base. '/api' = same-origin via the Next.js proxy
# (works on localhost, Replit, or any domain without rebuilding).
NEXT_PUBLIC_API_BASE_URL=/api

# ----------------------------------------------------------------------------
# Local image storage (no third-party provider).
# Uploads are saved under APP_STORAGE_DIR and served at /uploads/**.
# ----------------------------------------------------------------------------
APP_STORAGE_DIR=./uploads

# ----------------------------------------------------------------------------
# Store Contact Details (public)
# ----------------------------------------------------------------------------
NEXT_PUBLIC_STORE_NAME=Sree Padmavathi Silks
NEXT_PUBLIC_STORE_PHONE=+919291303040
NEXT_PUBLIC_STORE_UPI_ID=you@upi
NEXT_PUBLIC_STORE_LOCATION=Hindupur, Andhra Pradesh
